{
  "manifest_version": 3,
  "name": "APT LinkedIn Job Search",
  "version": "1.0",
  "description": "Hides specific jobs on LinkedIn job search page based on keywords.",
  "permissions": [
    "storage",
    "downloads",
    "tabs"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard.html",
        "dashboard.js",
        "ai_search_page.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/jobs/*",
        "*://linkedin.com/jobs/*"
      ],
      "js": [
        "content.js"
      ],
      "exclude_matches": [
        "*://*.linkedin.com/jobs/search-results/*",
        "*://linkedin.com/jobs/search-results/*"
      ]
    },
    {
      "matches": [
        "*://*.linkedin.com/jobs/search-results/*",
        "*://linkedin.com/jobs/search-results/*"
      ],
      "js": [
        "ai_search_page.js"
      ]
    }
  ]
}